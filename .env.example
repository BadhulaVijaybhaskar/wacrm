# Account-scoped WhatsApp Embedded Signup; disabled by default.
WACRM_EMBEDDED_SIGNUP=0
META_APP_ID=your-app-id
META_APP_SECRET=your-meta-app-secret
NEXT_PUBLIC_META_APP_ID=your-app-id
NEXT_PUBLIC_META_ES_CONFIG_ID=your-facebook-login-business-config-id
# Meta Graph API version; defaults to v26.0 when unset. Override to pin another version.
META_GRAPH_VERSION=v26.0
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WACRM_TOKEN_ENC_KEY=base64-of-32-random-bytes

# Server-only HMAC key for Embedded Signup callback state (runtime only).
# If unset, falls back to the first META_APP_SECRET with a one-time warning.
WACRM_ES_STATE_SECRET=replace-with-a-dedicated-random-secret
