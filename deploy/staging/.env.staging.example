# ============================================================
# Staging env for deploy/staging/docker-compose.staging.yml
# Copy to .env.staging and fill in values. NEVER commit .env.staging.
# Variable NAMES only below — leave values blank in this example.
# ============================================================

# ---- Public (inlined at Docker build time) ----

# Canonical public URL. Must be https and allow-listed on Connect's
# WACRM_MEDIA_HOSTS when you point at a real Connect (stub ignores hosts).
NEXT_PUBLIC_SITE_URL=https://wa.astraconnect.io

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# UI locale: en | ko | pt | es
NEXT_PUBLIC_APP_LOCALE=

# ---- Server secrets (runtime only; never bake into the image) ----

# Supabase service-role key (bypasses RLS; webhook / adapter / API keys)
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key for WhatsApp tokens (64 hex chars)
ENCRYPTION_KEY=

# Meta App Secret for x-hub-signature-256 on /api/whatsapp/webhook.
# Staging without a real Meta app: set a long random staging-only value
# and sign smoke-test webhooks with it (see DEPLOY.md → META_STUB).
META_APP_SECRET=

# Optional Meta App ID (image-header template uploads)
META_APP_ID=

# When "true"/"1", template submit skips Meta and stores a dry-run id.
# Recommended for staging without a WABA.
WHATSAPP_TEMPLATES_DRY_RUN=

# META_STUB mode (see DEPLOY.md). When "1", Embedded Signup returns fake
# numeric WABA/phone IDs and never calls Meta. Pair with
# WHATSAPP_TEMPLATES_DRY_RUN=true for a Meta-offline staging stack.
META_STUB=

# Embedded Signup scaffolding (1 = on)
WHATSAPP_EMBEDDED_SIGNUP=

# ---- Astra Connect adapter ----

# Base URL of Connect. Default in compose points at the local stub:
#   http://connect-stub:8090
# Do NOT set a live Connect URL on this staging stack.
CONNECT_ADAPTER_URL=

# Shared HMAC secret (≥16 chars). Same value on app and connect-stub.
WACRM_ADAPTER_SECRET=

# Opt-in outbound /message mirror (default off)
# CONNECT_MIRROR_OUTBOUND=0

# Optional: stub returns 429 on every N-th unique inbound message_id (default 5)
CONNECT_STUB_RATE_LIMIT_EVERY=

# Optional Astra billing usage webhook (empty → no-op)
# BILLING_WEBHOOK_URL=
# BILLING_WEBHOOK_SECRET=

# ---- Optional ops ----

# Cron secret for GET /api/automations/cron (Wait steps)
AUTOMATION_CRON_SECRET=

# Invite host allow-list (comma-separated hostnames, no scheme)
ALLOWED_INVITE_HOSTS=

# AI tuning (optional)
AI_REQUEST_TIMEOUT_MS=
AI_CONTEXT_MESSAGE_LIMIT=
